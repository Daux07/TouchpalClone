<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: with targetSdk 35 the window is edge-to-edge, and a system title
         bar over content that must handle its own insets is two things fighting for the
         same strip. The settings screen draws its own heading (SettingsActivity). -->
    <style name="Theme.T9Keyboard" parent="@android:style/Theme.Material.Light.NoActionBar" />
</resources>
