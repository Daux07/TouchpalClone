<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Il ritorno tattile sotto il dito. Permesso "normal": concesso all'installazione,
         non chiede nulla all'utente e non dà accesso ad alcun dato. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.T9Keyboard">

        <!-- The settings screen, and the app's only activity: an IME needs none to
             work, but a preference nobody can reach is not a preference. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The T9 Input Method Editor service. Requires the system-only
             BIND_INPUT_METHOD permission; no sensitive app permissions declared. -->
        <service
            android:name=".service.T9ImeService"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
